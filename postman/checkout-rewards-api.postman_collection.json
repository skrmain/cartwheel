{
  "info": {
    "_postman_id": "44cfca55-584f-46de-b845-144865755b99",
    "name": "Checkout and Rewards API",
    "description": "Ordered local demo for the checkout and rewards API. Run against a freshly seeded database with the local environment selected. Admin routes intentionally have no authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "cartId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "couponCode", "value": "" },
    { "key": "errorCartId", "value": "" },
    { "key": "couponCartId", "value": "" },
    { "key": "reuseCartId", "value": "" },
    { "key": "stockCartOne", "value": "" },
    { "key": "stockCartTwo", "value": "" },
    { "key": "milestoneCartId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - List products",
      "request": { "method": "GET", "url": "{{baseUrl}}/products" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Products are listed', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "02 - Create primary cart",
      "request": { "method": "POST", "url": "{{baseUrl}}/carts", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(201);", "pm.collectionVariables.set('cartId', pm.response.json().id);"] } }]
    },
    {
      "name": "03 - Add keyboard to primary cart",
      "request": { "method": "PUT", "url": "{{baseUrl}}/carts/{{cartId}}/items/prod-keyboard", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"quantity\":1}" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Item added', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "04 - View primary cart",
      "request": { "method": "GET", "url": "{{baseUrl}}/carts/{{cartId}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Cart is visible', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "05 - Checkout primary cart",
      "request": { "method": "POST", "url": "{{baseUrl}}/carts/{{cartId}}/checkout", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"expectedTotalCents\":7999}" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(201);", "pm.test('First checkout is not a replay', () => pm.expect(pm.response.json().replayed).to.eql(false));", "pm.collectionVariables.set('orderId', pm.response.json().id);"] } }]
    },
    {
      "name": "06 - Replay checkout (different coupon is ignored)",
      "request": { "method": "POST", "url": "{{baseUrl}}/carts/{{cartId}}/checkout", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"couponCode\":\"SAVE-REPLAY-IGNORED\"}" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(200);", "pm.test('Replay returns the original order', () => { pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('orderId')); pm.expect(pm.response.json().replayed).to.eql(true); });"] } }]
    },
    {
      "name": "Read original order (captured orderId)",
      "request": { "method": "GET", "url": "{{baseUrl}}/orders/{{orderId}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(200);", "pm.test('Order ID matches checkout', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('orderId')));"] } }]
    },
    {
      "name": "07 - Error: missing product",
      "request": { "method": "GET", "url": "{{baseUrl}}/products/no-such-product" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(404);", "pm.test('Error code is PRODUCT_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('PRODUCT_NOT_FOUND'));"] } }]
    },
    {
      "name": "08 - Error: quantity outside 1-100",
      "request": { "method": "PUT", "url": "{{baseUrl}}/carts/{{cartId}}/items/prod-keyboard", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"quantity\":101}" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(400);", "pm.test('Error code is VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"] } }]
    },
    {
      "name": "09 - Create empty cart for error case",
      "request": { "method": "POST", "url": "{{baseUrl}}/carts", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(201);", "pm.collectionVariables.set('errorCartId', pm.response.json().id);"] } }]
    },
    {
      "name": "10 - Error: checkout empty cart",
      "request": { "method": "POST", "url": "{{baseUrl}}/carts/{{errorCartId}}/checkout", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.response.to.have.status(422);", "pm.test('Error code is EMPTY_CART', () => pm.expect(pm.response.json().error.code).to.eql('EMPTY_CART'));"] } }]
    },
