    "version": "0.2.0",
    "configurations": [
        {
            "name": "DEBUG | cartwheel",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "cwd": "${workspaceFolder}",
            "autoAttachChildProcesses": true,
            "sourceMaps": true,
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal"
        }
    ]
}
